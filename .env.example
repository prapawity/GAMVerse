PORT=2567
VITE_REALTIME_URL=http://localhost:2567

# Google sign-in (optional). Leave unset to hide the Google button and 404 the /auth/google routes.
# All three are required to enable it. Redirect URI example: https://localhost:2567/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=

# Optional. Defaults to a key derived from INTERNAL_SERVICE_TOKEN.
# GOOGLE_STATE_SECRET=
# Set to 1 only when the API is behind a proxy (Caddy) that rewrites X-Forwarded-For; used for per-client rate limits.
# TRUST_PROXY_HEADERS=1
